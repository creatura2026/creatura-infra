aws_region                  = "eu-north-1"
cluster_name                = "creatura-backend"
kubernetes_version          = "1.36" # Vérifier disponibilité et support AWS avant apply.
deployment_principal_arn    = "arn:aws:iam::123456789012:role/creatura-deploy"
administrator_principal_arn = "arn:aws:iam::123456789012:role/creatura-admin"
endpoint_public_access_cidrs = ["203.0.113.10/32"] # Remplacer par l'IP de sortie du runner/admin.

# Images dans ECR, construites par CodeBuild (scripts/build-images.sh) : sans Docker local.
create_ecr_repositories = true
create_image_builder    = true

# Bastion SSM pour accéder à la base depuis un poste (bastion.tf), t3.micro de l'offre gratuite.
# create_bastion       = true
# bastion_tunnel_users = ["dbAccess"]

# Upload de sprites par les admins via l'API backend (rds.tf) : outputs du stack infra/.
# sprites_bucket_arn          = "arn:aws:s3:::creatura-assets-xxxx"
# cloudfront_distribution_arn = "arn:aws:cloudfront::123456789012:distribution/XXXXXXXXXXXX"

